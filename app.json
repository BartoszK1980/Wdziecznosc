{
  "expo": {
    "name": "Wdzięczność",
    "slug": "wdziecznosc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wdziecznosc",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.bartoszkubiak.wdziecznosc",
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Attach a photo from your library to a gratitude entry.",
        "NSCameraUsageDescription": "Take a photo to attach to a gratitude entry.",
        "NSFaceIDUsageDescription": "Unlock Wdzięczność with Face ID."
      }
    },
    "android": {
      "package": "com.bartoszkubiak.wdziecznosc",
      "adaptiveIcon": {
        "backgroundColor": "#FBF6F0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach a photo from your library to a gratitude entry.",
          "cameraPermission": "Take a photo to attach to a gratitude entry."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF6F0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock Wdzięczność with Face ID."
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      "expo-image",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "supabaseUrl": "",
      "supabaseKey": "",
      "admobBannerAndroid": "",
      "admobBannerIos": "",
      "revenueCatAndroidKey": "",
      "revenueCatIosKey": ""
    }
  }
}
